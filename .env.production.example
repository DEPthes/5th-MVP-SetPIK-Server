# Docker image and server
APP_IMAGE=setpik-server:latest
SERVER_PORT=8080
MYSQL_VERSION=8.4

# MySQL: replace every example value before deployment.
DB_NAME=setpik
DB_USERNAME=setpik
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

# Spotify OAuth
SPOTIFY_CLIENT_ID=CHANGE_ME
SPOTIFY_CLIENT_SECRET=CHANGE_ME
SPOTIFY_REDIRECT_URI=CHANGE_ME_HTTPS_BACKEND_URL/api/v1/auth/spotify/callback
SPOTIFY_COOKIE_SECURE=true

# SetPIK authentication
TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY
REFRESH_TOKEN_EXPIRATION=14d
OAUTH_SUCCESS_REDIRECT_URI=CHANGE_ME_FRONTEND_URL/oauth/success
OAUTH_FAILURE_REDIRECT_URI=CHANGE_ME_FRONTEND_URL/oauth/failure
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
JWT_SECRET=CHANGE_ME_BASE64_32_BYTE_KEY
ACCESS_TOKEN_EXPIRATION=30m

# KOPIS
KOPIS_API_KEY=CHANGE_ME
KOPIS_BASE_URL=http://www.kopis.or.kr/openApi/restful
KOPIS_DETAIL_CONCURRENCY=5
KOPIS_BATCH_SIZE=50
KOPIS_RETRY_MAX_ATTEMPTS=3
KOPIS_RETRY_DELAY=500ms
KOPIS_CONNECT_TIMEOUT=3s
KOPIS_READ_TIMEOUT=10s
KOPIS_SYNC_ENABLED=false
KOPIS_SYNC_CRON=0 0 3 * * *
KOPIS_SYNC_FUTURE_DAYS=1
JPA_BATCH_SIZE=50
